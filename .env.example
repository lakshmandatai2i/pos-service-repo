# ==============================================================================
# SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase API URL (Found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Public Key (Safe for browser / client-side apps with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Supabase Service Role Key (OPTIONAL - Secret admin key, server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Direct PostgreSQL Connection String (OPTIONAL - For direct database access)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
